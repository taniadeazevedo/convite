# Copia este archivo como .env.local y rellena lo que tengas. Nunca subas .env.local a GitHub.

# --- Pagos (Stripe). Sin clave, en desarrollo "Publicar" activa la invitación sin cobrar.
STRIPE_SECRET_KEY=
# Secreto del webhook (endpoint: /api/stripe/webhook, evento checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# --- Correos (Resend). Sin clave, los correos se escriben en data/correos.log en vez de enviarse.
RESEND_API_KEY=
# Remitente, con un dominio verificado en Resend. Ejemplo: Invitalia <hola@invitalia.es>
EMAIL_FROM=
# Opcional: a dónde llegan las respuestas de los clientes. Por defecto, el correo de contacto de los textos legales.
EMAIL_REPLY_TO=

# --- Servidor
# Dirección pública de la web (para enlaces de correos y el QR). Ejemplo: https://tudominio.com
SITE_URL=
# Correo de la cuenta que puede ver las estadísticas de ventas en /cuenta/estadisticas
ADMIN_EMAIL=
# Opcional: correo al que enviar cada día una copia de la base de datos (cuentas, invitaciones, confirmaciones).
# Contiene datos personales: usad una dirección solo vuestra.
BACKUP_EMAIL=
# Carpeta del disco permanente donde se guardan la base de datos y las fotos. Ejemplo: /data
DATA_DIR=
