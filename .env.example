# Clave secreta de Stripe. Sin ella, en desarrollo "Publicar" activa la invitación sin cobrar.
STRIPE_SECRET_KEY=
# Secreto del webhook de Stripe (endpoint: /api/stripe/webhook, evento checkout.session.completed)
STRIPE_WEBHOOK_SECRET=
# Dirección pública de la web (para los enlaces y el QR), p. ej. https://tudominio.com
SITE_URL=
